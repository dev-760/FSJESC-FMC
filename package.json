{
  "name": "fsjesc-fmc",
  "version": "0.1.0",
  "private": true,
  "description": "FSJESC Financial Markets Club — financial education and paper-trading simulation platform (simulated market, MAD).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @fsjesc/landing db:migrate",
    "db:seed": "pnpm --filter @fsjesc/landing db:seed",
    "api:dev": "uvicorn app.main:app --reload --app-dir api --port 8000",
    "api:test": "python -m pytest api/tests -q",
    "verify": "turbo run typecheck lint test build"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
