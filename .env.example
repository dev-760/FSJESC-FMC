# ─────────────────────────────────────────────────────────────────────────────
# FSJESC Financial Markets Club — environment template
# Copy to `.env.local` and fill in. NEVER commit real values.
# Every variable below is validated by `src/config/env.ts` (Zod), which fails
# fast on misconfiguration. Secrets are server-only and must never be exposed
# to the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Primary data layer: Drizzle ORM + PostgreSQL.
#
# Either a local Postgres (docker-compose service `db`) or a Supabase project.
#
# Supabase connection strings — pick ONE:
#
#   Transaction pooler (recommended; IPv4, works everywhere):
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Session pooler (supports prepared statements; still needs prepare=false here):
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct connection (IPv6 only, no pooler):
#     postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# <password> is the database password from Dashboard -> Settings -> Database.
# URL-encode it: characters like @ : / # must be percent-escaped.
#
# Local development database (docker-compose service `db`).
DATABASE_URL="postgresql://fsjesc:fsjesc_dev_password@localhost:5432/fsjesc_fmc"

# Maximum pooled connections. Supabase caps this per project (tighter on the
# free tier); leave unset to use the default of 5.
# DATABASE_POOL_MAX="5"
# Prepared statements are off by default so the transaction pooler works.
# Set to "true" only against a direct connection or session pooler.
# DATABASE_PREPARE="false"
# TLS. Supabase requires it and it is enabled automatically for *.supabase.co
# and *.pooler.supabase.com. A local docker Postgres has no TLS, so it stays off.
# Override only if your setup differs.
# DATABASE_SSL="require"

# Throwaway database used by the integration suite (docker-compose service `db-test`).
# Integration tests self-skip when this is unset.
TEST_DATABASE_URL="postgresql://fsjesc:fsjesc_test_password@localhost:5433/fsjesc_fmc_test"

# ── Auth (Auth.js v5) ─────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating AUTH_SECRET invalidates all sessions (safe: users simply sign in again).
AUTH_SECRET="replace-with-32-byte-base64-secret"
# Required when running behind a reverse proxy / non-Vercel host.
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# ── Bootstrap administrator (used only by `pnpm db:seed`) ────────────────────
# The seed script creates this account with the ADMIN role. Password must be at
# least 12 characters. Change the password before deploying anywhere public.
BOOTSTRAP_ADMIN_EMAIL="admin@fsjesc-fmc.local"
BOOTSTRAP_ADMIN_PASSWORD="change-me-at-least-12-chars"
BOOTSTRAP_ADMIN_NAME="Platform Administrator"

# ── Demo / seed data ─────────────────────────────────────────────────────────
# `SEED_DEMO=true` is REQUIRED to seed demo data when NODE_ENV=production.
SEED_DEMO="false"
# Deterministic seed for the simulated market. Changing it regenerates history.
MARKET_SEED="fsjesc-fmc-v1"

# ── Supabase (optional — used to read the `articles` topic library) ───────────
# The primary data layer is Drizzle + Postgres (see DATABASE_URL above).
# Supabase is a secondary source for published topics. When these are unset the
# app reads topics from src/content/topics instead, so leaving them blank is safe.
#
# New key format only: `sb_publishable_…` / `sb_secret_…`.
# The legacy `service_role` / `anon` JWTs are NOT accepted. An earlier commit
# contains a `service_role` JWT that is still recoverable from git history —
# revoke that legacy signing secret in the Supabase dashboard
# (Authentication → Signing Keys → rotate to standby, then revoke).
SUPABASE_URL=""
# Server-only secret key. Bypasses RLS and grants full access to every table.
# NEVER commit it.
SUPABASE_SECRET_KEY=""
# Safe to expose to a browser. Constrained by Row Level Security.
SUPABASE_PUBLISHABLE_KEY=""
# Used to verify Supabase Auth JWTs.
SUPABASE_JWKS_URL=""

# ── Mail ─────────────────────────────────────────────────────────────────────
# `console` logs the message (and any verification / reset link) to the server
# console — the default for local development. Set to `smtp` in production.
MAIL_PROVIDER="console"
MAIL_FROM="FSJESC Financial Markets Club <no-reply@fsjesc-fmc.local>"
# Required when MAIL_PROVIDER=smtp.
# SMTP_URL="smtps://user:password@smtp.example.com:465"

# ── Public application configuration (inlined into the client bundle) ───────
# Values are frozen at build time. Only non-sensitive, display-level settings.
NEXT_PUBLIC_APP_NAME="FSJESC Financial Markets Club"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@fsjesc-fmc.local"

# ── Feature flags ────────────────────────────────────────────────────────────
# Comma-separated overrides. Anything not listed uses the defaults in
# `src/config/feature-flags.ts`. Valid: `on` / `off`.
NEXT_PUBLIC_FEATURE_SIMULATOR="on"
NEXT_PUBLIC_FEATURE_ADMIN="on"

# ── Cross-app wiring ─────────────────────────────────────────────────────────
# Three apps run side by side (see pnpm-workspace.yaml). Each has its own port
# in development and its own subdomain in production, so links between them
# cannot be relative — they are built with simulatorUrl() in
# packages/config/simulator.ts.

# Where the simulator app lives. Used by the landing app's links and by the
# shared components in packages/ui, which render in both apps.
NEXT_PUBLIC_SIMULATOR_URL="http://localhost:3002"

# The API belongs to the landing app. The simulator proxies /api/* here via
# rewrites() rather than reimplementing the routes, so shared components can
# keep using relative URLs and no CORS headers are needed.
SIMULATOR_API_ORIGIN="http://localhost:3000"

# Where AMS is served. Used for post-sign-in redirects into the console.
NEXT_PUBLIC_AMS_URL="http://localhost:3001"

# The API belongs to the landing app. AMS proxies /api/* here via rewrites()
# (same pattern as the simulator), so the shared session cookie reaches the
# admin handlers without CORS.
AMS_API_ORIGIN="http://localhost:3000"

# Optional. Set to a parent domain (e.g. `.fsjes.ma`) so landing, simulator and
# AMS subdomains share one session cookie. Leave unset for localhost.
# AUTH_COOKIE_DOMAIN=".fsjes.ma"

# ── External Market Data API (api/) ──────────────────────────────────────────
# FastAPI Multi-Asset & Casablanca Stock Exchange (CSE) Market Data API.
MARKET_API_URL="https://api.wassly.tech"
# Optional X-API-Key header when API_KEY authentication is enabled on the service.
# MARKET_API_KEY=""

