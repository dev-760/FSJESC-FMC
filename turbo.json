{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env.*local"],
  /**
   * Three Next apps plus a TypeScript typecheck run flat-out exhaust this
   * machine, and `tsc --incremental` races the app builds over
   * `tsconfig.tsbuildinfo`. Every symptom was a task passing in isolation and
   * failing only under concurrency, so the graph is deliberately not fanned out
   * as wide as the machine would allow.
   */
  "concurrency": "50%",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "DATABASE_POOL_MAX",
        "DATABASE_PREPARE",
        "DATABASE_SSL",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_URL",
        "AUTH_COOKIE_DOMAIN",
        "BOOTSTRAP_ADMIN_EMAIL",
        "BOOTSTRAP_ADMIN_PASSWORD",
        "BOOTSTRAP_ADMIN_NAME",
        "SEED_DEMO",
        "MARKET_SEED",
        "MAIL_PROVIDER",
        "SMTP_URL",
        "MAIL_FROM",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_JWKS_URL",
        "SIMULATOR_API_ORIGIN",
        "AMS_API_ORIGIN",
        "MARKET_API_URL",
        "MARKET_API_KEY"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "next.config.ts",
        "**/*.ts",
        "**/*.tsx"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_TRUST_HOST",
        "AUTH_URL",
        "MARKET_SEED",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_JWKS_URL",
        "MARKET_API_URL"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
