# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
API_KEY=
PROJECT_NAME=Market Data API
VERSION=1.0.0

# Provider Configuration
FRED_API_KEY=your_fred_api_key_here
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
CSE_API_KEY=your_cse_api_key_here

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_QUOTES=30
CACHE_TTL_INTRADAY=60
CACHE_TTL_DAILY=3600
CACHE_TTL_OPTIONS=60
CACHE_TTL_FRANKFURTER=3600
CACHE_TTL_FRED_OBSERVATIONS=3600
CACHE_TTL_FRED_METADATA=86400

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# HTTP Client Configuration (use integer seconds, e.g. 30, for uv / Vercel build compatibility)
HTTP_TIMEOUT=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=1
RETRY_MAX_DELAY=30
